<?xml version="1.0" encoding="utf-8"?>
<!-- 食品合成器（挂墙） -->
<Patch>
  <!-- 钢铁 = 750 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/costList/Steel</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/costList/Steel/text()</xpath>
      <value>500</value>
    </match>
  </Operation>
  <!-- 玻璃钢 = 75 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/costList/Plasteel</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/costList/Plasteel/text()</xpath>
      <value>75</value>
    </match>
  </Operation>
  <!-- 工作量 = 7500 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/statBases/WorkToBuild</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/statBases/WorkToBuild/text()</xpath>
      <value>7500</value>
    </match>
  </Operation>
  <!-- 不会短路 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain/text()</xpath>
      <value>false</value>
    </match>
  </Operation>
  <!-- 功耗 = 750 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatFeedTankLarge"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption/text()</xpath>
      <value>750</value>
    </match>
  </Operation>
</Patch>
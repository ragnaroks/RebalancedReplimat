<?xml version="1.0" encoding="utf-8"?>
<!-- 食品合成器 -->
<Patch>
  <!-- 钢铁 = 200 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/costList/Steel</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/costList/Steel/text()</xpath>
      <value>200</value>
    </match>
  </Operation>
  <!-- 零部件 + 20 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/costList/ComponentIndustrial</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/costList/ComponentIndustrial/text()</xpath>
      <value>20</value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/costList</xpath>
      <value>
        <ComponentIndustrial>20</ComponentIndustrial>
      </value>
    </nomatch>
  </Operation>
  <!-- 价值 = 5000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/MarketValue</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/MarketValue/text()</xpath>
      <value>5000</value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/MarketValueIgnoreHp</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/MarketValueIgnoreHp/text()</xpath>
      <value>5000</value>
    </match>
  </Operation>
  <!-- 工作量 = 1500 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/WorkToBuild</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/statBases/WorkToBuild/text()</xpath>
      <value>1500</value>
    </match>
  </Operation>
  <!-- 不会短路 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain/text()</xpath>
      <value>false</value>
    </match>
  </Operation>
  <!-- 功耗 = 100 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption/text()</xpath>
      <value>100</value>
    </match>
  </Operation>
  <!-- 运行时功耗 = 1000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminal"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption/text()</xpath>
      <value>1000</value>
    </match>
  </Operation>
</Patch>
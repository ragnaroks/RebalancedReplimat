<?xml version="1.0" encoding="utf-8"?>
<!-- 食品合成器（挂墙） -->
<Patch>
  <!-- 钢铁 = 160 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/costList/Steel</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/costList/Steel/text()</xpath>
      <value>160</value>
    </match>
  </Operation>
  <!-- 零部件 + 16 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/costList/ComponentIndustrial</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/costList/ComponentIndustrial/text()</xpath>
      <value>16</value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/costList</xpath>
      <value>
        <ComponentIndustrial>16</ComponentIndustrial>
      </value>
    </nomatch>
  </Operation>
  <!-- 价值 = 4500 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/MarketValue</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/MarketValue/text()</xpath>
      <value>4500</value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/MarketValueIgnoreHp</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/MarketValueIgnoreHp/text()</xpath>
      <value>4500</value>
    </match>
  </Operation>
  <!-- 工作量 = 1250 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/WorkToBuild</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/statBases/WorkToBuild/text()</xpath>
      <value>1250</value>
    </match>
  </Operation>
  <!-- 不会短路 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain/text()</xpath>
      <value>false</value>
    </match>
  </Operation>
  <!-- 功耗 = 100 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption/text()</xpath>
      <value>100</value>
    </match>
  </Operation>
  <!-- 运行时功耗 = 1000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatTerminalWall"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption/text()</xpath>
      <value>1000</value>
    </match>
  </Operation>
</Patch>
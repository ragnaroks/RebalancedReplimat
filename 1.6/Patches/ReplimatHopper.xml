<?xml version="1.0" encoding="utf-8"?>
<!-- 食品合成器（挂墙） -->
<Patch>
  <!-- 钢铁 = 300 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/costList/Steel</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/costList/Steel/text()</xpath>
      <value>300</value>
    </match>
  </Operation>
  <!-- 高级零部件 = 2 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/costList/ComponentSpacer</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/costList/ComponentSpacer/text()</xpath>
      <value>2</value>
    </match>
  </Operation>
  <!-- 价值 = 4000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/MarketValue</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/MarketValue/text()</xpath>
      <value>4000</value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/MarketValueIgnoreHp</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/MarketValueIgnoreHp/text()</xpath>
      <value>4000</value>
    </match>
  </Operation>
  <!-- 工作量 = 1000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/WorkToBuild</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/WorkToBuild/text()</xpath>
      <value>1000</value>
    </match>
  </Operation>
  <!-- 质量 = 30 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/Mass</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/statBases/Mass/text()</xpath>
      <value>30</value>
    </match>
  </Operation>
  <!-- 每单位存储堆叠 = 5 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/building/maxItemsInCell</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/building/maxItemsInCell/text()</xpath>
      <value>5</value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/building</xpath>
      <value>
        <maxItemsInCell>5</maxItemsInCell>
      </value>
    </nomatch>
  </Operation>
  <!-- 不会短路 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="CompProperties_Power"]/shortCircuitInRain/text()</xpath>
      <value>false</value>
    </match>
  </Operation>
  <!-- 功耗 = 100 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption/text()</xpath>
      <value>100</value>
    </match>
  </Operation>
  <!-- 运行时功耗 = 1000 -->
  <Operation Class="PatchOperationConditional" MayRequire="sumghai.Replimat">
    <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ReplimatHopper"]/comps/li[@Class="Replimat.CompProperties_StateDependentPowerUse"]/activeModePowerConsumption/text()</xpath>
      <value>1000</value>
    </match>
  </Operation>
</Patch>